APP_NAME=niche-social-network
APP_ENV=development
APP_DEBUG=true
APP_DEMO_MODE=false
API_V1_PREFIX=/api/v1

MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=niche_social
REDIS_URL=redis://localhost:6379/0
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=local_dev_password


# Development default only. Production requires a shared secret of at least 32 characters.
AUTH_SECRET=local-development-only-change-before-deployment
ACCESS_TOKEN_SECONDS=3600
