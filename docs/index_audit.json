  "neo4j_queries": [
    {"name": "P1_followers", "query": "\n            MATCH (follower:User)-[r:FOLLOWS]->(author:User {id: $user_id})\n            WHERE coalesce(r.status, 'accepted') = 'accepted'\n              AND coalesce(follower.account_status, 'active') = 'active'\n              AND coalesce(author.account_status, 'active') = 'active'\n              AND NOT (follower)-[:BLOCKS]-(author)\n            RETURN DISTINCT follower.id AS id ORDER BY id\n            ", "parameters": {"user_id": "ae5f1083-aede-5f6b-ab7f-1c67c8062f9f"}, "samples_ms": [37.102, 41.881, 38.659, 43.634, 37.301], "median_ms": 38.659, "operators": ["AntiSemiApply@neo4j", "Argument@neo4j", "Distinct@neo4j", "Expand(All)@neo4j", "Expand(Into)@neo4j", "Filter@neo4j", "NodeUniqueIndexSeek@neo4j", "ProduceResults@neo4j", "Sort@neo4j"], "db_hits": 31146},
    {"name": "P4_mutual", "query": "\n            MATCH (u1:User {id:$u1})-[r1:FOLLOWS]->(f:User)\n                  <-[r2:FOLLOWS]-(u2:User {id:$u2})\n            WHERE f <> u1 AND f <> u2\n              AND coalesce(r1.status,'accepted')='accepted'\n              AND coalesce(r2.status,'accepted')='accepted'\n              AND coalesce(u1.account_status,'active')='active'\n              AND coalesce(u2.account_status,'active')='active'\n              AND coalesce(f.account_status,'active')='active'\n              AND NOT (u1)-[:BLOCKS]-(f)\n              AND NOT (u2)-[:BLOCKS]-(f)\n              AND NOT (u1)-[:BLOCKS]-(u2)\n            RETURN DISTINCT f.id AS id ORDER BY id\n            ", "parameters": {"u1": "93291b26-24ea-50ef-b44c-80e08e237c57", "u2": "f6147781-d5fe-50c9-97c8-62bb6241e152"}, "samples_ms": [7.719, 8.402, 7.722, 15.905, 7.701], "median_ms": 7.722, "operators": ["AntiSemiApply@neo4j", "Argument@neo4j", "Distinct@neo4j", "Expand(All)@neo4j", "Expand(Into)@neo4j", "Filter@neo4j", "NodeHashJoin@neo4j", "NodeUniqueIndexSeek@neo4j", "ProduceResults@neo4j", "Sort@neo4j"], "db_hits": 27374},
    {"name": "P4_candidates", "query": "\n            MATCH (u:User {id:$id})-[r1:FOLLOWS]->(middle:User)\n                  -[r2:FOLLOWS]->(candidate:User)\n            WHERE candidate <> u\n              AND ($after IS NULL OR candidate.id > $after)\n              AND coalesce(r1.status,'accepted')='accepted'\n              AND coalesce(r2.status,'accepted')='accepted'\n              AND coalesce(u.account_status,'active')='active'\n              AND coalesce(middle.account_status,'active')='active'\n              AND coalesce(candidate.account_status,'active')='active'\n              AND NOT (u)-[:FOLLOWS]->(candidate)\n              AND NOT (u)-[:BLOCKS]-(middle)\n              AND NOT (middle)-[:BLOCKS]-(candidate)\n              AND NOT (u)-[:BLOCKS]-(candidate)\n            RETURN candidate.id AS id, count(DISTINCT middle) AS score\n            ORDER BY id LIMIT $limit\n            ", "parameters": {"id": "93291b26-24ea-50ef-b44c-80e08e237c57", "after": null, "limit": 200}, "samples_ms": [67.719, 57.31, 57.37, 70.329, 56.902], "median_ms": 57.37, "operators": ["AntiSemiApply@neo4j", "Argument@neo4j", "EagerAggregation@neo4j", "Expand(All)@neo4j", "Expand(Into)@neo4j", "Filter@neo4j", "NodeUniqueIndexSeek@neo4j", "ProduceResults@neo4j", "Top@neo4j"], "db_hits": 1509878},
    {"name": "P8_relationships", "query": "\n            MATCH (u:User {id:$id})-[r]-(other:User)\n            RETURN type(r) AS kind, startNode(r)=u AS outgoing,\n                   other.id AS other_id, coalesce(r.status,'accepted') AS status\n            ORDER BY kind, other_id\n        ", "parameters": {"id": "ae5f1083-aede-5f6b-ab7f-1c67c8062f9f"}, "samples_ms": [40.432, 41.92, 40.741, 44.497, 41.585], "median_ms": 41.585, "operators": ["Expand(All)@neo4j", "Filter@neo4j", "NodeUniqueIndexSeek@neo4j", "ProduceResults@neo4j", "Projection@neo4j", "Sort@neo4j"], "db_hits": 6039}
